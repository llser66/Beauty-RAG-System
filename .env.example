# SiliconFlow API 配置（必填）
# 注册地址: https://siliconflow.cn
SILICONFLOW_API_KEY=sk-your-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# API 鉴权 Token（推荐填写；留空时后端首次启动会自动生成并写入 .env）
API_BEARER_TOKEN=

# Milvus 连接地址（可选，默认为本地）
MILVUS_URI=http://127.0.0.1:19530

# 知识库目录（可选）
KNOWLEDGE_DIR=./knowledge_base

# 后端端口（前后端默认统一使用 8877）
API_PORT=8877

# Streamlit 前端访问的后端地址（可选）
API_BASE_URL=http://127.0.0.1:8877

# 单个上传文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=50

# 聊天皮肤图片的最长保留时间（小时），到期自动删除
CHAT_UPLOAD_RETENTION_HOURS=24
